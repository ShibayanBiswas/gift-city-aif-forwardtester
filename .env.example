# ── Local / Render (backend) ──────────────────────────────────────────
# Required for Mongo persistence. App still runs if these are omitted.
# Encode @ in passwords as %40.
# Set these on RENDER only (never on Vercel).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.lvoycia.mongodb.net/gift_aif_forwardtester?retryWrites=true&w=majority
MONGODB_DB=gift_aif_forwardtester

# Optional alias accepted by the backend (same meaning as MONGODB_URI):
# MONGO_URI=

# ── Vercel (frontend) ─────────────────────────────────────────────────
# Set in Vercel → Project → Settings → Environment Variables (Production):
# BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com
# (no trailing slash; used by next.config.ts /api rewrite + /api/wake cron)
#
# Optional — faster cold starts (browser talks to Render directly, CORS already open):
# NEXT_PUBLIC_BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com
#
# Full layman deploy guide: docs/08-deploy-vercel-render.md
BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_BACKEND_URL=

# Optional local port overrides (start.ps1 / start.bat / start.sh):
# API_PORT=8000
# UI_PORT=3000

# Optional parallelism on Render / local (FORWARDTEST_* preferred; BACKTEST_* still accepted):
# FORWARDTEST_MODE=serial|threads|processes
# FORWARDTEST_WORKERS=4
# FORWARDTEST_CONSTRAINED=0
